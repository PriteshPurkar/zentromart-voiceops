# ============================================================
# ZentroMart VoiceOps 2026 — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- LLM provider: "openai" or "groq" ---
LLM_PROVIDER=groq

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Groq ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Gnani voice (STT + TTS) ---
GNANI_API_KEY=your_gnani_key_here
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_VOICE=Kaveri
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_LANGUAGE=en-IN

# --- Paths (relative to project root) ---
DATA_DIR=data
KB_DIR=kb
PRACTICE_DIR=practice
TOOLS_DIR=tools
INDEX_DIR=cache/index
OUTPUT_DIR=sample_outputs